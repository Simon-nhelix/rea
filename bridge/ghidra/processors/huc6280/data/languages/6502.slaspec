# sleigh specification file for MOS 6502

define endian=little;
define alignment=1;

define space RAM     type=ram_space      size=2  default;
define space register type=register_space size=1;

define register offset=0x00  size=1 [ A X Y P ];
define register offset=0x20 size=2  [ PC      SP   ];
define register offset=0x20 size=1  [ PCL PCH S SH ];
define register offset=0x30 size=1 [ N V B D I Z C T ];	# status bits

#TOKENS

define token opbyte (8)
   op       = (0,7)

   aaa      = (5,7)
   bbb      = (2,4)
   cc       = (0,1)
;

define token data8 (8)
   imm8		= (0,7)
   rel		= (0,7) signed
;

define token data (16)
	imm16 = (0,15)
;

# REA HuC6280 logical stack: low byte wraps within $2100-$21FF.
macro hucPush8(value) {
 local ptr:2 = 0x2100 + zext(S);
 *:1 ptr = value;
 S = S - 1;
 SH = 0x21;
}
macro hucPop8(value) {
 S = S + 1;
 SH = 0x21;
 local ptr:2 = 0x2100 + zext(S);
 value = *:1 ptr;
}
macro hucPush16(value) {
 local word:2 = value;
 local hi:1 = word(1);
 local lo:1 = word:1;
 hucPush8(hi);
 hucPush8(lo);
}
macro hucPop16(value) {
 local lo:1;
 local hi:1;
 hucPop8(lo);
 hucPop8(hi);
 value = (zext(hi) << 8) | zext(lo);
}

macro popSR() {
	local ccr:1;
 hucPop8(ccr);
	N = ccr[7,1];
	V = ccr[6,1];
	T = ccr[5,1];
 B = 1;
	D = ccr[3,1];
	I = ccr[2,1];
	Z = ccr[1,1];
	C = ccr[0,1];
}

macro pushSR() {
	local ccr:1 = 0xff;
	ccr[7,1] = N;
	ccr[6,1] = V;
	ccr[5,1] = T;
 ccr[4,1] = 1;
	ccr[3,1] = D;
	ccr[2,1] = I;
	ccr[1,1] = Z;
	ccr[0,1] = C;
	hucPush8(ccr);
}

macro resultFlags(value) {
	Z = (value == 0);
	N = (value s< 0);
}

# HuC6280 T is sampled for ADC/AND/EOR/ORA only, then consumed.
# Addressing operands have already been evaluated before these macros execute.
macro hucReadAcc(value, mode, pointer) {
 mode = T;
 T = 0;
 pointer = 0x2000 + zext(X);
 value = A;
 if (mode == 0) goto <done>;
 value = *:1 pointer;
 <done>
}
macro hucWriteAcc(value, mode, pointer) {
 if (mode == 0) goto <accumulator>;
 *:1 pointer = value;
 goto <done>;
 <accumulator>
 A = value;
 <done>
 resultFlags(value);
}
macro hucAdc(operand) {
 local lhs:1;
 local mode:1;
 local pointer:2;
 hucReadAcc(lhs, mode, pointer);
 local rhs:1 = operand;
 local result:1;
 local sum:2;
 if (D != 0) goto <decimal>;
 sum = zext(lhs) + zext(rhs) + zext(C);
 result = sum:1;
 V = ((~(lhs ^ rhs) & (lhs ^ result)) & 0x80) != 0;
 goto <flags>;
 <decimal>
 local low:2 = zext(lhs & 0xf) + zext(rhs & 0xf) + zext(C);
 if (low <= 9) goto <low_done>;
 low = low + 6;
 <low_done>
 sum = zext(lhs & 0xf0) + zext(rhs & 0xf0) + (zext(low > 0xf) << 4) + (low & 0xf);
 if (sum <= 0x9f) goto <high_done>;
 sum = sum + 0x60;
 <high_done>
 result = sum:1;
 <flags>
 C = sum > 0xff;
 hucWriteAcc(result, mode, pointer);
}
macro hucSbc(operand) {
 # Hudson manual and Mesen: SBC consumes T but does not redirect A.
 T = 0;
 local rhs:1 = operand;
 local inv:1 = ~rhs;
 local sum:4;
 local result:1;
 if (D != 0) goto <decimal>;
 sum = zext(A) + zext(inv) + zext(C);
 result = sum:1;
 V = (((A ^ rhs) & (A ^ result)) & 0x80) != 0;
 goto <flags>;
 <decimal>
 local low:4 = zext(A & 0xf) + zext(inv & 0xf) + zext(C);
 if (low s> 0xf) goto <low_done>;
 low = low - 6;
 <low_done>
 sum = zext(A & 0xf0) + zext(inv & 0xf0) + (zext(low s> 0xf) << 4) + (low & 0xf);
 if (sum s> 0xff) goto <high_done>;
 sum = sum - 0x60;
 <high_done>
 result = sum:1;
 <flags>
 C = sum s> 0xff;
 A = result;
 resultFlags(A);
}
macro hucAnd(operand) {
 local lhs:1; local mode:1; local pointer:2;
 hucReadAcc(lhs, mode, pointer);
 local result:1 = lhs & operand;
 hucWriteAcc(result, mode, pointer);
}
macro hucEor(operand) {
 local lhs:1; local mode:1; local pointer:2;
 hucReadAcc(lhs, mode, pointer);
 local result:1 = lhs ^ operand;
 hucWriteAcc(result, mode, pointer);
}
macro hucOra(operand) {
 local lhs:1; local mode:1; local pointer:2;
 hucReadAcc(lhs, mode, pointer);
 local result:1 = lhs | operand;
 hucWriteAcc(result, mode, pointer);
}



################################################################
# Pseudo Instructions
################################################################

define pcodeop readIRQ;

################################################################
REL: reloc		is rel	[ reloc = inst_next + rel; ] { export *:2 reloc; }

# Immediate
OP1: "#"imm8    is bbb=2; imm8			{ tmp:1 = imm8; export tmp; }
# Zero Page
OP1: imm8       is bbb=1; imm8			{ local ptr:2 = 0x2000 + imm8; export *:1 ptr; }
# Zero Page Indexed X
OP1: imm8,X     is bbb=5 & X; imm8		{ tmp:2 = 0x2000 + zext(imm8 + X); export *:1 tmp; }
# Absolute
OP1: imm16      is bbb=3; imm16			{ export *:1 imm16; }
# Absolute Indexed X
OP1: imm16,X    is bbb=7 & X; imm16		{ tmp:2 = imm16 + zext(X); export *:1 tmp; }
# Absolute Indexed Y
OP1: imm16,Y    is bbb=6 & Y; imm16		{ tmp:2 = imm16 + zext(Y); export *:1 tmp; }
# Indirect X
OP1: (imm8,X)   is bbb=0 & X; imm8		{ zp:1 = imm8 + X; addr:2 = 0x2000 + zext(zp); lo:1 = *:1 addr; zp = zp + 1; addr = 0x2000 + zext(zp); hi:1 = *:1 addr; tmp:2 = (zext(hi) << 8) | zext(lo); export *:1 tmp; }
# Indirect Y
OP1: (imm8),Y   is bbb=4 & Y; imm8		{ zp:1 = imm8; addr:2 = 0x2000 + zext(zp); lo:1 = *:1 addr; zp = zp + 1; addr = 0x2000 + zext(zp); hi:1 = *:1 addr; tmp:2 = (zext(hi) << 8) | zext(lo); tmp = tmp + zext(Y); export *:1 tmp; }

# Immediate
OP2: "#"imm8    is bbb=0; imm8			{ tmp:1 = imm8; export tmp; }
# Zero Page
OP2: imm8       is bbb=1; imm8			{ local ptr:2 = 0x2000 + imm8; export *:1 ptr; }
OP2: A          is bbb=2 & A            { export A; }
# Absolute
OP2: imm16      is bbb=3; imm16			{ export *:1 imm16; }
# Zero Page Indexed X
OP2: imm8,X     is bbb=5 & X; imm8		{ tmp:2 = 0x2000 + zext(imm8 + X); export *:1 tmp; }
# Absolute Indexed X
OP2: imm16,X    is bbb=7 & X; imm16		{ tmp:2 = imm16 + zext(X); export *:1 tmp; }

OP2ST: OP2      is OP2                  { export OP2; }
OP2ST: imm8,Y   is bbb=5 & Y; imm8		{ tmp:2 = 0x2000 + zext(imm8 + Y); export *:1 tmp; }

OP2LD: OP2      is OP2                  { export OP2; }
OP2LD: imm8,Y   is bbb=5 & Y; imm8		{ tmp:2 = 0x2000 + zext(imm8 + Y); export *:1 tmp; }
OP2LD: imm16,Y  is bbb=7 & Y; imm16		{ tmp:2 = imm16 + zext(Y); export *:1 tmp; }


ADDR8:  imm8    is imm8		{ local ptr:2 = 0x2000 + imm8; export *:1 ptr; }
ADDR16: imm16   is imm16   	{ export *:1 imm16; }
ADDRI:  (imm16)   is imm16    { addr:2 = imm16; lo:1 = *:1 addr; addr = addr + 1; hi:1 = *:1 addr; target:2 = (zext(hi) << 8) | zext(lo); export target; }


# Instructions


:ADC OP1     is (cc=1 & aaa=3) ... & OP1
{
 local operand:1 = OP1;
 hucAdc(operand);
}

:AND OP1     is (cc=1 & aaa=1) ... & OP1
{
 local operand:1 = OP1;
 hucAnd(operand);
}

:ASL OP2     is (op=0x06 | op=0x0A | op=0x0E | op=0x16 | op=0x1E) ... & OP2
{
 T = 0;
	local tmp = OP2;
	C = tmp >> 7;
	tmp = tmp << 1;
	OP2 = tmp;
	resultFlags(tmp);
}

:BCC  REL			is op=0x90; REL
{
 T = 0;
	if (C == 0) goto REL;
}

:BCS  REL			is op=0xB0; REL
{
 T = 0;
	if (C) goto REL;
}

:BEQ  REL			is op=0xF0; REL
{
 T = 0;
	if (Z) goto REL;
}

:BIT OP2     is (op=0x24 | op=0x2C) ... & OP2
{
 T = 0;
 local operand:1 = OP2;
	N = (operand & 0x80) == 0x80;
	V = (operand & 0x40) == 0x40;
	local value = A & operand;
	Z = (value == 0);
}

:BMI  REL			is op=0x30; REL
{
 T = 0;
	if (N) goto REL;
}

:BNE  REL			is op=0xD0; REL
{
 T = 0;
	if (Z == 0) goto REL;
}

:BPL  REL			is op=0x10; REL
{
 T = 0;
	if (N == 0) goto REL;
}

:BRK   is op=0x00
{
 T = 0;
	hucPush16(inst_next + 1);
	B = 1;
	pushSR();
 D = 0;
	I = 1;
	local target:2 = 0xFFF6;
	goto [*:2 target];
}

:BVC  REL			is op=0x50; REL
{
 T = 0;
	if (V == 0) goto REL;
}

:BVS  REL			is op=0x70; REL
{
 T = 0;
	if (V) goto REL;
}

:CLC     is op=0x18
{
 T = 0;
	C = 0;
}

:CLD     is op=0xD8
{
 T = 0;
	D = 0;
}

:CLI     is op=0x58
{
 T = 0;
	I = 0;
}

:CLV     is op=0xB8
{
 T = 0;
	V = 0;
}

:CMP OP1     is (cc=1 & aaa=6) ... & OP1
{
 T = 0;
	local op1 = OP1;
	local tmp = A - op1;
	resultFlags(tmp);
	C = (A >= op1);
}

:CPX OP2     is (op=0xE0 | op=0xE4 | op=0xEC) ... & OP2
{
 T = 0;
	local op1 = OP2;
	local tmp = X - op1;
	resultFlags(tmp);
	C = (X >= op1);
}

:CPY OP2     is (op=0xC0 | op=0xC4 | op=0xCC) ... & OP2
{
 T = 0;
	local op1 = OP2;
	local tmp = Y - op1;
	resultFlags(tmp);
	C = (Y >= op1);
}

:DEC OP2     is (op=0xC6 | op=0xCE | op=0xD6 | op=0xDE) ... & OP2
{
 T = 0;
	local tmp = OP2 - 1;
	OP2 = tmp;
	resultFlags(tmp);
}

:DEX     is op=0xCA
{
 T = 0;
	X = X - 1;
	resultFlags(X);
}


:DEY     is op=0x88
{
 T = 0;
	Y = Y -1;
	resultFlags(Y);
}

:EOR OP1     is (cc=1 & aaa=2) ... & OP1
{
 local operand:1 = OP1;
 hucEor(operand);
}

:INC OP2     is (op=0xE6 | op=0xEE | op=0xF6 | op=0xFE) ... & OP2
{
 T = 0;
	local tmp = OP2 + 1;
	OP2 = tmp;
	resultFlags(tmp);
}

:INY     is op=0xC8
{
 T = 0;
	Y = Y + 1;
	resultFlags(Y);
}

:INX     is op=0xE8
{
 T = 0;
	X = X + 1;
	resultFlags(X);
}

:JMP ADDR16     is (op=0x4C); ADDR16
{
 T = 0;
	goto ADDR16;
}

:JMP ADDRI     is (op=0x6c); ADDRI
{
 T = 0;
	goto [ADDRI];
}

:JSR   ADDR16    is op=0x20; ADDR16
{
 T = 0;
	hucPush16(inst_next - 1);
	call ADDR16;
}

:LDA OP1     is (cc=1 & aaa=5) ... & OP1
{
 T = 0;
	A = OP1;
	resultFlags(A);
}

:LDY OP2     is (op=0xA0 | op=0xA4 | op=0xAC | op=0xB4 | op=0xBC) ... & OP2
{
 T = 0;
	Y = OP2;
	resultFlags(Y);
}

:LDX OP2LD     is (op=0xA2 | op=0xA6 | op=0xAE | op=0xB6 | op=0xBE) ... & OP2LD
{
 T = 0;
	X = OP2LD;
	resultFlags(X);
}

:LSR OP2     is (op=0x46 | op=0x4A | op=0x4E | op=0x56 | op=0x5E) ... & OP2
{
 T = 0;
	local tmp = OP2;
	C = tmp & 1;
	tmp = tmp >> 1;
	OP2 = tmp;
	Z = (tmp == 0);
	N = 0;
}

:NOP     is op=0xEA
{
 T = 0;
}

:ORA  OP1    is  (cc=1 & aaa=0) ... & OP1
{
 local operand:1 = OP1;
 hucOra(operand);
}

:PHP     is op=0x8
{
 T = 0;
	pushSR();
}

:PLP     is op=0x28
{
 T = 0;
	popSR();
}

:PHA     is op=0x48
{
 T = 0;
	hucPush8(A);
}

:PLA     is op=0x68
{
 T = 0;
	hucPop8(A);
	resultFlags(A);
}

:ROL OP2     is (op=0x26 | op=0x2A | op=0x2E | op=0x36 | op=0x3E) ... & OP2
{
 T = 0;
	local tmpC = C;
	local op2 = OP2;
	C = op2 >> 7;
	local result = op2 << 1;
	result = result | tmpC;
	OP2 = result;
	resultFlags(result);
}

:ROR OP2     is (op=0x66 | op=0x6A | op=0x6E | op=0x76 | op=0x7E) ... & OP2
{
 T = 0;
	local tmpC = C << 7;
	local tmp = OP2;
	C = tmp & 1;
	tmp = tmp >> 1;
	tmp = tmp | tmpC;
	OP2 = tmp;
	resultFlags(tmp);
}

:RTI      is op=0x40
{
 T = 0;
	popSR();

    local tmp:2;
 hucPop16(tmp);

	return [tmp];
}

:RTS      is op=0x60
{
 T = 0;
	local tmp:2;
 hucPop16(tmp);

	tmp = tmp + 1;
 return [tmp];
}

:SBC OP1     is (cc=1 & aaa=7) ... & OP1
{
 local operand:1 = OP1;
 hucSbc(operand);
}

:SEC     is op=0x38
{
 T = 0;
	C = 1;
}

:SED     is op=0xF8
{
 T = 0;
	D = 1;
}

:SEI     is op=0x78
{
 T = 0;
	I = 1;
}

:STA OP1     is (cc=1 & aaa=4) ... & OP1
{
 T = 0;
	OP1 = A;
}

:STX OP2ST     is (op=0x86 | op=0x8E | op=0x96) ... & OP2ST
{
 T = 0;
	OP2ST = X;
}

:STY OP2     is (op=0x84 | op=0x8C | op=0x94) ... & OP2
{
 T = 0;
	OP2 = Y;
}

:TAX     is op=0xAA
{
 T = 0;
	X = A;
	resultFlags(X);
}

:TAY     is op=0xA8
{
 T = 0;
	Y = A;
	resultFlags(Y);
}

:TSX     is op=0xBA
{
 T = 0;
	X = S;
    resultFlags(X);
}

:TXA     is op=0x8A
{
 T = 0;
	A = X;
	resultFlags(A);
}

:TXS     is op=0x9A
{
 T = 0;
	S = X;
 SH = 0x21;
}

:TYA     is op=0x98
{
 T = 0;
	A = Y;
	resultFlags(A);
}
