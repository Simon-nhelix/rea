  <default_symbols>
    <symbol name="IRQ2_BRK" address="FFF6" entry="true" type="code_ptr"/>
    <symbol name="IRQ1" address="FFF8" entry="true" type="code_ptr"/>
    <symbol name="TIMER" address="FFFA" entry="true" type="code_ptr"/>
    <symbol name="NMI" address="FFFC" entry="true" type="code_ptr"/>
    <symbol name="RES" address="FFFE" entry="true" type="code_ptr"/>
